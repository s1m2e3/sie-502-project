    uses <http://www.example.com/method/bundle#>
    includes <http://www.example.com/project/quantities#>
    includes <http://www.example.com/project/system#>
    includes <http://www.example.com/project/conditions#>
    includes <http://www.example.com/project/verification#>
    includes <http://www.example.com/project/requirements#>
    includes <http://www.example.com/project/stakeholders#>
}
