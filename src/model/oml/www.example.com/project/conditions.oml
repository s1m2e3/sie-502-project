@dc:title "Conditions"
@dc:description "The logic behind each requirement: comparisons, compounds and quantifiers over the system's inputs and outputs."
description <http://www.example.com/project/conditions#> as conditions {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/base#> as base
    uses <http://www.example.com/method/expression#> as expression
    extends <http://www.example.com/project/quantities#> as quantities
    extends <http://www.example.com/project/system#> as system

    //
    // Thresholds: one value and one unit each; comparisons point to them
    //

    instance T_MinOutletTemperature : expression:Threshold [
        base:description "Minimum outlet nitrogen temperature (400 C)"
        expression:thresholdValue 673.15
        expression:hasUnit quantities:K
    ]

    instance T_MinOutletMassFlow : expression:Threshold [
        base:description "Minimum outlet nitrogen mass flow"
        expression:thresholdValue 1.8
        expression:hasUnit quantities:kg_per_h
    ]

    instance T_MaxOutletTemperature : expression:Threshold [
        base:description "Maximum outlet nitrogen temperature (600 C)"
        expression:thresholdValue 873.15
        expression:hasUnit quantities:K
    ]

    instance T_MaxWallTemperature : expression:Threshold [
        base:description "Maximum bare pipe surface temperature (650 C)"
        expression:thresholdValue 923.15
        expression:hasUnit quantities:K
    ]

    instance T_TouchLimit : expression:Threshold [
        base:description "Touch-safe surface temperature limit (50 C)"
        expression:thresholdValue 323.15
        expression:hasUnit quantities:K
    ]

    instance T_MinCapturedPower : expression:Threshold [
        base:description "Minimum captured solar power"
        expression:thresholdValue 2.0
        expression:hasUnit quantities:kW
    ]

    // R1: AND of two leaves
    instance C_R1 : expression:CompoundCondition [
        base:description "During operation, at the design solar irradiance of 800 W/m2 or more: both the outlet temperature and the outlet flow conditions hold (AND)"
        expression:connective "AND"
    ]

    instance C_R1_Temperature : expression:Comparison [
        base:description "During operation, at the design solar irradiance of 800 W/m2 or more, the outlet nitrogen temperature is at least 673.15 K (400 C)"
        expression:isOperandOf C_R1
        expression:constrains system:OutletNitrogenTemperature
        expression:hasInput system:OperationMode
        expression:hasInput system:SolarIrradiance
        expression:comparisonOperator "GE"
        expression:hasThreshold T_MinOutletTemperature
    ]

    instance C_R1_Flow : expression:Comparison [
        base:description "During operation, the outlet nitrogen mass flow is at least 1.8 kg/h"
        expression:isOperandOf C_R1
        expression:constrains system:OutletNitrogenMassFlow
        expression:hasInput system:OperationMode
        expression:comparisonOperator "GE"
        expression:hasThreshold T_MinOutletMassFlow
    ]

    // R2: AND of two leaves
    instance C_R2 : expression:CompoundCondition [
        base:description "During operation: neither the delivered gas nor the pipe exceeds its thermal limit (AND)"
        expression:connective "AND"
    ]

    instance C_R2_OutletLimit : expression:Comparison [
        base:description "During operation, the outlet nitrogen temperature is at most 873.15 K (600 C)"
        expression:isOperandOf C_R2
        expression:constrains system:OutletNitrogenTemperature
        expression:hasInput system:OperationMode
        expression:comparisonOperator "LE"
        expression:hasThreshold T_MaxOutletTemperature
    ]

    instance C_R2_WallLimit : expression:Comparison [
        base:description "During operation, the bare pipe surface temperature is at most 923.15 K (650 C)"
        expression:isOperandOf C_R2
        expression:constrains system:BarePipeSurfaceTemperature
        expression:hasInput system:OperationMode
        expression:comparisonOperator "LE"
        expression:hasThreshold T_MaxWallTemperature
    ]

    // R3: a single categorical leaf
    instance C_R3 : expression:Predicate [
        base:description "During operation, the composition of the delivered gas is nitrogen"
        expression:constrains system:OutletGasComposition
        expression:hasInput system:OperationMode
        expression:comparisonOperator "EQ"
        expression:targetValue "nitrogen"
    ]

    // R4: for all accessible surfaces, during maintenance
    instance C_R4 : expression:QuantifiedCondition [
        base:description "During maintenance, for every accessible surface temperature in the set, the touch limit holds (ForAll)"
        expression:quantifier "ForAll"
        expression:quantifiesOver system:AccessibleSurfaceTemperatures
    ]

    instance C_R4_TouchLimit : expression:Comparison [
        base:description "During maintenance, an accessible surface temperature is at most 323.15 K (50 C)"
        expression:isBodyOf C_R4
        expression:constrains system:AccessibleSurfaceTemperatures
        expression:hasInput system:MaintenanceMode
        expression:comparisonOperator "LE"
        expression:hasThreshold T_TouchLimit
    ]

    // R5: a single power leaf
    instance C_R5 : expression:Comparison [
        base:description "During operation, at the design solar irradiance of 800 W/m2 or more, the captured solar power is at least 2.0 kW"
        expression:constrains system:CapturedSolarPower
        expression:hasInput system:OperationMode
        expression:hasInput system:SolarIrradiance
        expression:comparisonOperator "GE"
        expression:hasThreshold T_MinCapturedPower
    ]
}
