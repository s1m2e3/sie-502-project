@dc:title "Expression Vocabulary"
@dc:description "Conditions over outputs: atomic predicates and comparisons, aggregated by logical connectives and quantifiers."
vocabulary <http://www.example.com/method/expression#> as expression {
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2001/XMLSchema#> as xsd
    extends <http://www.example.com/method/base#> as base
    extends <http://www.example.com/method/units#> as units

    //--- enumerations ---
    scalar ComparisonOperator [ oneOf "EQ","NE","GT","GE","LT","LE" ] //= xsd:string   (NE covers negation)
    scalar LogicalConnective  [ oneOf "AND","OR" ]                    //= xsd:string
    scalar Quantifier         [ oneOf "ForAll","Exists" ]             //= xsd:string
    scalar ExchangeKind       [ oneOf "Abstraction","Energy","Matter" ] //= xsd:string   (modes are Abstraction)

    //--- what a condition talks about ---
    @dc:description "Something that crosses the system boundary: qualified as abstraction (e.g. a mode), energy, or matter."
    aspect Exchanged

    @dc:description "A thing observations are taken on: a flow, a part, a region, a state. Not an architectural component."
    concept Entity < base:Element

    @dc:description "An entity with a physical extent: a flow, a part, a region of the world."
    concept PhysicalEntity < Entity

    @dc:description "An entity with no physical extent: a state machine, a lifecycle, a plan."
    concept AbstractEntity < Entity

    @dc:description "The measured variable a condition constrains."
    concept Output < base:Element, Exchanged [ restricts hasExchangeKind to exactly 1 ]

    @dc:description "A variable imposed on the system: physical inputs (sunlight, inlet flow) and imposed modes (operation, maintenance)."
    concept Input  < base:Element, Exchanged [ restricts hasExchangeKind to exactly 1 ]

    scalar property hasExchangeKind [ domain Exchanged range ExchangeKind functional ]

    // --- the condition tree ---
    @dc:description "Abstract: instantiate only Predicate, Comparison, CompoundCondition or QuantifiedCondition."
    concept Condition < base:Expressible, base:Element

    concept AtomicCondition < Condition [          // the leaf tier: output + operator + value
        restricts constrains to exactly 1
        restricts comparisonOperator to exactly 1
    ]
    concept Predicate  < AtomicCondition [ restricts targetValue    to exactly 1 ]   // categorical value (EQ/NE)
    @dc:description "A numeric bound on an output: exactly one operator against exactly one threshold. A range is two comparisons (lower and upper bound) joined by AND."
    concept Comparison < AtomicCondition [ restricts hasThreshold to exactly 1 ]

    concept CompoundCondition < Condition [        // AND/OR over >= 2 whole conditions (its operands)
        restricts hasSubcondition to min 2
        restricts connective to exactly 1
    ]
    concept QuantifiedCondition < Condition [      // ForAll/Exists X in a set: its one subcondition (the body) holds
        restricts quantifier      to exactly 1
        restricts quantifiesOver  to exactly 1
        restricts hasSubcondition to exactly 1
    ]

    // --- properties ---
    scalar property comparisonOperator [ domain AtomicCondition     range ComparisonOperator functional ]
    scalar property targetValue        [ domain Predicate           range xsd:string         functional ]
    quantity property irradianceLevel      [ domain Exchanged             quantity units:Irradiance    functional ]   // design point of an observable
    quantity property apertureArea         [ domain Entity                quantity units:Area          functional ]
    scalar property connective         [ domain CompoundCondition   range LogicalConnective  functional ]
    scalar property quantifier         [ domain QuantifiedCondition range Quantifier         functional ]

    // --- measurements: quantity kinds, units and thresholds are data, so users can add new ones ---
    @dc:description "Something with a physical dimension, written as exponents of the ISQ base dimensions (e.g. M1 L2 T-3 for power, H1 for temperature). Dimensionless quantities have dimension 1."
    aspect Dimensioned
    scalar property hasDimension [ domain Dimensioned range xsd:string functional ]

    @dc:description "Whether a quantity kind has a physical dimension (temperature, power) or is dimensionless (ratios, efficiencies, statistical metrics)."
    scalar Dimensionality [ oneOf "Dimensional","Dimensionless" ]
    scalar property hasDimensionality [ domain QuantityKind range Dimensionality functional ]

    @dc:description "A kind of quantity: dimensional (temperature, mass flow rate, power) or dimensionless (efficiency, coefficient of variation). Defined on the author-owned Quantities and Units page."
    concept QuantityKind < base:Element, Dimensioned [
        restricts hasDimension to exactly 1
        restricts hasDimensionality to exactly 1
    ]

    @dc:description "A unit of measure (K, kg/h, kW). Measures exactly one quantity kind and must share its dimension. Defined on the author-owned Quantities and Units page."
    concept Unit < base:Element, Dimensioned [
        restricts measuresQuantity to exactly 1
        restricts hasDimension to exactly 1
        restricts unitSymbol to exactly 1
    ]
    scalar property unitSymbol [ domain Unit range xsd:string functional ]

    @dc:description "A numeric value with its unit, used as the bound of a comparison."
    concept Threshold < base:Element [
        restricts thresholdValue to exactly 1
        restricts hasUnit to exactly 1
    ]
    scalar property thresholdValue [ domain Threshold range xsd:decimal functional ]

    relation measuresQuantity [ from Unit to QuantityKind reverse isMeasuredIn functional ]
    relation hasUnit [ from Threshold to Unit reverse isUnitOf functional ]
    relation hasThreshold [ from Comparison to Threshold reverse isThresholdOf functional ]
    relation hasQuantityKind [ from Output to QuantityKind reverse isQuantityKindOf functional ]   // numeric outputs only; categorical ones have none

    // --- relations ---
    relation constrains [ from AtomicCondition to Output reverse isConstrainedBy ]
    relation hasPart [                             // entity composition: a pipe has its sections
        from Entity to Entity
        reverse isPartOf
        asymmetric irreflexive ]
    relation observedOn [                          // FACE-style: an Entity exhibits observables
        from Exchanged to Entity
        reverse exhibits
        functional ]
    relation hasInput   [ from AtomicCondition to Input reverse isInputTo ]   // context lives on the leaves, not on compounds/quantifiers
    @dc:description "Links a condition to the conditions it is built from. The role follows from the parent: under AND/OR a subcondition is an operand, under ForAll/Exists it is the body."
    relation hasSubcondition [                     // one relation, not operand + body: the tree editor nests by a single parent link
        from Condition to Condition
        reverse isSubconditionOf
        inverse functional asymmetric irreflexive ]
    relation quantifiesOver [                      // exactly one set; mixed kinds = user defines a set Output (e.g. munitions)
        from QuantifiedCondition to Output
        reverse isQuantifiedBy
        functional ]
    relation hasMember [                           // set membership between outputs: munitions hasMember missiles, bombs
        from Output to Output
        reverse isMemberOf
        transitive ]                               // no asymmetric/irreflexive: OWL 2 DL forbids them on transitive relations
}
