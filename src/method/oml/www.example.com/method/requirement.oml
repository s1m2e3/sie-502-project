@dc:title "Requirement Vocabulary"
@dc:description "Stakeholders, the requirements they raise, the conditions those impose, and the testing strategies that verify them."
vocabulary <http://www.example.com/method/requirement#> as requirement {
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.example.com/method/base#> as base
    extends <http://www.example.com/method/expression#> as expression

    scalar VerificationMethodKind [ oneOf "Analysis","Inspection","Test","Demonstration" ]

    @dc:description "A party with a stake in the system. Modeled only if it raises at least one requirement; otherwise it is redundant. Never instantiated directly: every stakeholder is a Regulator, InternalClient, ExternalClient, Press, or Provider."
    concept Stakeholder < base:Element [
        restricts raises to min 1
    ]

    @dc:description "A single, verifiable statement of need. Every requirement must be raised by at least one stakeholder and verified by at least one testing strategy."
    concept Requirement < base:Element, base:Expressible [
        restricts hasCondition to exactly 1
        restricts isRaisedBy to min 1
        restricts isVerifiedBy to min 1
    ]
    scalar property hasVerificationMethod [ domain TestingStrategy range VerificationMethodKind functional ]

    concept TestingStrategy < base:Element [
        restricts hasVerificationMethod to exactly 1
    ]

    relation raises [
        from Stakeholder
        to Requirement
        reverse isRaisedBy
    ]

    relation hasCondition [
        from Requirement 
        to expression:Condition
        reverse isConditionOf
        functional
    ]
    
    relation isVerifiedBy [
    from Requirement
    to TestingStrategy
    reverse verifies
    ]

    @dc:description "A stakeholder with regulatory authority over the system (safety, compliance)."
    concept Regulator < Stakeholder

    @dc:description "A party inside the owning organization that uses or runs the system (plant managers, operators, maintenance)."
    concept InternalClient < Stakeholder

    @dc:description "A party outside the owning organization that buys from or depends on the system's output."
    concept ExternalClient < Stakeholder

    @dc:description "Media that report on the system, its safety, or its environmental impact."
    concept Press < Stakeholder

    @dc:description "A supplier of components, materials, or services for the system."
    concept Provider < Stakeholder

    @dc:description "Defined: any requirement raised by a regulator. The reasoner classifies these; they are never asserted."
    concept SafetyRequirement = Requirement [
        restricts some isRaisedBy to Regulator
    ]
}
